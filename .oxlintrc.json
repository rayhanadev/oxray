{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true
  },
  "jsPlugins": ["./src/plugin.ts"],
  "rules": {
    "oxray/no-type-erasure": "error",
    "oxray/no-typeof": "error"
  }
}
