{
  "name": "@rayhanadev/ox",
  "version": "0.2.0",
  "description": "Opinionated Oxlint rules and project scaffolding powered by Oxc",
  "keywords": [
    "formatter",
    "lint",
    "oxc",
    "oxfmt",
    "oxlint",
    "typescript"
  ],
  "homepage": "https://github.com/rayhanadev/oxray#readme",
  "bugs": {
    "url": "https://github.com/rayhanadev/oxray/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rayhanadev/oxray.git"
  },
  "bin": {
    "ox": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/plugin.js",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./plugin": "./dist/plugin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:cli && bun run build:plugin",
    "build:cli": "bun build src/cli.ts --outfile dist/cli.js --target node --format esm --packages external",
    "build:plugin": "bun build src/plugin.ts --outfile dist/plugin.js --target node --format esm --packages external",
    "changeset": "changeset",
    "format": "oxfmt",
    "lint": "oxlint",
    "release": "changeset publish",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "version": "changeset version",
    "prepublishOnly": "bun run build && bun test && bun run typecheck"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "jsonc-parser": "^3.3.1",
    "nypm": "^0.6.9"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.3.14",
    "oxclippy": "^0.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
